# Copy to .env and adjust. All services read these (env-overridable everywhere).

# --- backend (control plane) ---
DATABASE_URL=sqlite:///./.data/platform.db   # AWS: postgresql+psycopg://user:pass@host/db
ML_SERVICE_URL=http://localhost:8001
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:3000

# Google sign-in (optional — leave blank to hide the "Continue with Google" button).
# One-time setup (~2 min; must be done by a human in the Google Cloud Console):
#   1. https://console.cloud.google.com/ -> create or select a project.
#   2. APIs & Services -> OAuth consent screen -> External; add your email as a test user.
#   3. APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> "Web application".
#   4. Authorized redirect URI (must match GOOGLE_REDIRECT_URI below exactly):
#        http://localhost:8000/auth/google/callback
#   5. Paste the generated Client ID + secret here and restart the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-change-me
# training knobs for the local small-model run (scale these up on a GPU host)
TRAIN_CART_TOKENS=64
TRAIN_STEPS=60
TRAIN_GRAD_ACCUM=8
TRAIN_GEN_QS=6

# --- ml service (the only torch process) ---
# Production default (in code) is Qwen/Qwen3-30B-A3B. A laptop can't hold 30B, so
# this LOCAL override points at a small model. Bump to Qwen3-1.7B/8B for better
# local quality. MUST be open-weights (cartridges inject KV into the frozen model).
CARTRIDGES_MODEL=Qwen/Qwen3-0.6B
# CARTRIDGES_DTYPE=bfloat16                  # compute dtype: bfloat16 (default) | float16

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker-compose real stack (Postgres+pgvector / MinIO / Redis) ---
POSTGRES_USER=cartridge
POSTGRES_PASSWORD=cartridge
POSTGRES_DB=cartridge
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
