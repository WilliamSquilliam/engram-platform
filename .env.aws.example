# ============================================================================
# AWS / PRODUCTION environment template. Do NOT commit real secrets — provide
# these as ECS task-definition env vars / AWS Secrets Manager (preferred), or
# copy to `.env` on the host. Real process env overrides any file, so on AWS you
# typically inject these directly rather than shipping a file. Local config:
# .env.local (auto-loaded).
# ============================================================================

# --- data stores: managed services ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@your-db.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/cartridge
PLATFORM_STORAGE_DIR=/mnt/storage     # shared EFS volume (or wire S3 into storage.py)

# ============================================================================
# SERVING UNIT — the four contract values. A serving unit is ANY GPU stack that
# emits these four; the control plane knows nothing else about the hardware/cloud.
# The AWS GPU unit in infra/serving-aws/ produces them as terraform outputs — paste
# `terraform output -raw serving_unit_env` here after apply + provision. The values
# below are PLACEHOLDERS shaped exactly like that output (Llama-3.3-70B-FP8 tier).
# ============================================================================
# Resident-KV serving: chat goes to the vLLM Inference Service (a separate GPU process).
# The control plane retrieves cart doc_ids and hands them over — no per-query prefill.
INFERENCE_BACKEND=vllm
# 1/4  onboarding / train worker (:8001)  <- terraform output ml_service_url
ML_SERVICE_URL=http://10.0.0.10:8001
# 2/4  vLLM resident-KV serve (:8002)     <- terraform output inference_service_url
INFERENCE_SERVICE_URL=http://10.0.0.10:8002
# 3/4  shared ML-plane bearer both serving processes enforce
#      <- terraform output -raw ml_auth_token  (mark sensitive; inject via Secrets Manager)
ML_AUTH_TOKEN=__set_from_terraform_output_ml_auth_token__
# 4/4  product model tiers (id/label/model_ref/precision/context_tokens/enabled)
#      <- terraform output -raw model_registry_json  (the balanced tier serves the box's model)
MODEL_REGISTRY_JSON=[{"id":"balanced","label":"Balanced","description":"Best grounded accuracy per cost. The default.","model_ref":"RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic","precision":"fp8","context_tokens":131072,"enabled":true}]
DEFAULT_MODEL_TIER=balanced
INFERENCE_TOPK=3
# The Inference Service reads carts from the same durable store the onboarding worker wrote.
# Same bucket the serving unit's CARTRIDGE_STORE_BUCKET output names, so the control plane's
# retrieval index hydration and the GPU box share one cart store.
CARTRIDGE_STORE_BACKEND=s3
CARTRIDGE_STORE_BUCKET=engram-carts-808379776072-us-east-1
CARTRIDGE_STORE_PREFIX=cartridges
CORS_ORIGINS=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# --- auth: set strong random secrets via Secrets Manager ---
JWT_SECRET=__set_a_strong_random_secret__
SESSION_SECRET=__set_a_strong_random_secret__
GOOGLE_CLIENT_ID=          # inject via Secrets Manager / ECS env — do NOT commit secrets here
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback

# --- training knobs: GPU host, closer to paper scale ---
TRAIN_CART_TOKENS=512
TRAIN_STEPS=2000
TRAIN_GRAD_ACCUM=64
TRAIN_GEN_QS=40

# --- production hardening + pluggable infra backends ---------------------------
# ENV=production makes the API refuse to boot with dev-default secrets and enables
# secure cookies / strict CORS. LOG_LEVEL tunes structured logging.
ENV=production
LOG_LEVEL=INFO

# Object storage: s3 puts documents in S3/MinIO (durable) with a local working
# mirror for the GPU worker. Omit (or =local) to use the shared EFS volume only.
PLATFORM_STORAGE_BACKEND=s3
PLATFORM_S3_BUCKET=cartridge-prod
# S3_ENDPOINT_URL=http://minio:9000        # only for MinIO; unset for real AWS S3

# Durable jobs: rq runs training on a separate `python -m app.worker` process via
# Redis, so runs survive API restarts. inline = in-process BackgroundTask (dev).
JOB_BACKEND=rq
REDIS_URL=redis://your-redis.cache.amazonaws.com:6379/0

# Retrieval backend (which carts to compose): tfidf (default) | pgvector.
RETRIEVAL_BACKEND=tfidf

# Auth backend: local (our JWTs) | oidc (verify Keycloak/Cognito JWTs via JWKS).
AUTH_BACKEND=oidc
OIDC_ISSUER=https://keycloak.yourdomain.com/realms/cartridge
OIDC_AUDIENCE=cartridge-frontend
# OIDC_JWKS_URL defaults to {OIDC_ISSUER}/protocol/openid-connect/certs
